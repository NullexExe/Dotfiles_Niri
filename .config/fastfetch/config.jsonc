{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "right": 2
    }
  },

  "modules": [
    "title",
    "separator",

    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },

    "break",

    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "RAM",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "Disk",
      "format": "{size-used} / {size-total}"
    },

    "break",

    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "localip",
      "key": "IP"
    },

    "break",
    "colors"
  ]
}
